{
  "search.exclude": {
    "**/data": true,
    "**/dist": true,
    "**/.dev": true,
    "**/node_modules": true,
    "**/.venv": true,
    "frontend/src/api/schema.d.ts": true,
    "**/pnpm-lock.yaml": true,
    "**/uv.lock": true
  },
  "files.watcherExclude": {
    "**/data/**": true,
    "**/dist/**": true,
    "**/.dev/**": true,
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "frontend/src/api/schema.d.ts": true,
    "**/pnpm-lock.yaml": true,
    "**/uv.lock": true
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv",
  "eslint.useFlatConfig": true,
  "unocss.root": ["frontend"]
}
