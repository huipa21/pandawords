DEFINE TABLE IF NOT EXISTS restore_receipt SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS owner ON restore_receipt TYPE record<user> ASSERT $value = record::id($this.id)[0];
DEFINE FIELD IF NOT EXISTS bundle ON restore_receipt TYPE string ASSERT string::len($value) = 64;
DEFINE FIELD IF NOT EXISTS id ON restore_receipt ASSERT $value = type::record('restore_receipt', [$this.owner, $this.bundle]);
DEFINE FIELD IF NOT EXISTS restored_at ON restore_receipt TYPE datetime;
DEFINE FIELD IF NOT EXISTS projects ON restore_receipt TYPE array<record<project>>;
DEFINE FIELD IF NOT EXISTS summary ON restore_receipt TYPE object FLEXIBLE;
DEFINE INDEX IF NOT EXISTS restore_receipt_owner ON restore_receipt FIELDS owner;
DEFINE INDEX IF NOT EXISTS lemma_owner ON lemma FIELDS owner;
DEFINE INDEX IF NOT EXISTS lexeme_owner ON lexeme FIELDS owner;
DEFINE INDEX IF NOT EXISTS sense_owner ON sense FIELDS owner;
DEFINE INDEX IF NOT EXISTS morpheme_owner ON morpheme FIELDS owner;
DEFINE INDEX IF NOT EXISTS sentence_owner ON sentence FIELDS owner;
DEFINE INDEX IF NOT EXISTS passage_owner ON passage FIELDS owner;
DEFINE INDEX IF NOT EXISTS media_owner ON media FIELDS owner;
DEFINE INDEX IF NOT EXISTS override_owner ON override FIELDS owner;
DEFINE INDEX IF NOT EXISTS has_lexeme_owner ON has_lexeme FIELDS owner;
DEFINE INDEX IF NOT EXISTS has_sense_owner ON has_sense FIELDS owner;
DEFINE INDEX IF NOT EXISTS derives_to_owner ON derives_to FIELDS owner;
DEFINE INDEX IF NOT EXISTS relates_to_owner ON relates_to FIELDS owner;
DEFINE INDEX IF NOT EXISTS contains_owner ON contains FIELDS owner;
DEFINE INDEX IF NOT EXISTS used_in_owner ON used_in FIELDS owner;
DEFINE INDEX IF NOT EXISTS part_of_owner ON part_of FIELDS owner;
