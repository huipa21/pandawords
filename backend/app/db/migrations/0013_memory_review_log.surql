DEFINE TABLE IF NOT EXISTS memory SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS owner ON memory TYPE record<user> ASSERT $value = record::id($this.id)[0];
DEFINE FIELD IF NOT EXISTS sense ON memory TYPE record<sense> ASSERT $value = record::id($this.id)[1];
DEFINE FIELD IF NOT EXISTS id ON memory ASSERT $value = type::record('memory', [$this.owner, $this.sense]);
DEFINE FIELD IF NOT EXISTS card_id ON memory TYPE int;
DEFINE FIELD IF NOT EXISTS state ON memory TYPE int ASSERT $value IN [1, 2, 3];
DEFINE FIELD IF NOT EXISTS step ON memory TYPE option<int> ASSERT $value = NONE OR $value >= 0;
DEFINE FIELD IF NOT EXISTS stability ON memory TYPE option<float>;
DEFINE FIELD IF NOT EXISTS difficulty ON memory TYPE option<float>;
DEFINE FIELD IF NOT EXISTS due ON memory TYPE datetime;
DEFINE FIELD IF NOT EXISTS last_review ON memory TYPE option<datetime>;
DEFINE FIELD IF NOT EXISTS introduced ON memory TYPE bool;
DEFINE INDEX IF NOT EXISTS memory_owner_sense ON memory FIELDS owner, sense UNIQUE;
DEFINE INDEX IF NOT EXISTS memory_owner_due ON memory FIELDS owner, due;

DEFINE TABLE IF NOT EXISTS review_log SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS owner ON review_log TYPE record<user> ASSERT $value = record::id($this.memory)[0];
DEFINE FIELD IF NOT EXISTS memory ON review_log TYPE record<memory>;
DEFINE FIELD IF NOT EXISTS project ON review_log TYPE record<project>;
DEFINE FIELD IF NOT EXISTS exercise ON review_log TYPE string;
DEFINE FIELD IF NOT EXISTS correct ON review_log TYPE bool;
DEFINE FIELD IF NOT EXISTS hint_used ON review_log TYPE bool;
DEFINE FIELD IF NOT EXISTS duration_ms ON review_log TYPE int ASSERT $value >= 0 AND $value <= 60000;
DEFINE FIELD IF NOT EXISTS auto_rating ON review_log TYPE int ASSERT $value IN [1, 2, 3, 4];
DEFINE FIELD IF NOT EXISTS rating ON review_log TYPE int ASSERT $value IN [1, 2, 3, 4];
DEFINE FIELD IF NOT EXISTS at ON review_log TYPE datetime;
DEFINE FIELD IF NOT EXISTS is_introduction ON review_log TYPE bool;
DEFINE FIELD IF NOT EXISTS attempt_id ON review_log TYPE string ASSERT string::len($value) > 0;
DEFINE INDEX IF NOT EXISTS review_log_owner_at ON review_log FIELDS owner, at;
DEFINE INDEX IF NOT EXISTS review_log_owner_attempt ON review_log FIELDS owner, attempt_id UNIQUE;
