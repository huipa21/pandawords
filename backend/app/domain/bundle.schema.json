        "stability": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stability"
        },
        "state": {
          "maximum": 3,
          "minimum": 1,
          "title": "State",
          "type": "integer"
        },
        "step": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonNegative"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "card_id",
        "state",
        "due"
      ],
      "title": "Card",
      "type": "object"
    },
    "ComposedOfEdge": {
