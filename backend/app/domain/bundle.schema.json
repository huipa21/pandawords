          "$ref": "#/$defs/ComposedOfEdge"
        },
        {
          "$ref": "#/$defs/DerivesToEdge"
        },
        {
          "$ref": "#/$defs/RelatesToEdge"
        },
        {
          "$ref": "#/$defs/MemberOfEdge"
