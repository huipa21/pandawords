      "enum": [
        "pandawords.project",
        "pandawords.user",
        "pandawords.site"
      ],
      "type": "string"
    },
    "Card": {
      "additionalProperties": false,
      "properties": {
        "card_id": {
          "$ref": "#/$defs/Int"
        },
        "difficulty": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Difficulty"
        },
        "due": {
          "$ref": "#/$defs/Instant"
        },
        "last_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/Instant"
            },
            {
              "type": "null"
            }
          ],
          "default": null
