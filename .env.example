SURREAL_URL=ws://127.0.0.1:8100/rpc
SURREAL_TEST_URL=ws://127.0.0.1:8101/rpc
SURREAL_NAMESPACE=pandawords
SURREAL_DATABASE=dev
SURREAL_USER=root
SURREAL_PASS=change-me

API_PORT=8000
WEB_DEV_PORT=5173
PUBLIC_BASE_URL=http://localhost:5173
APP_ENV=development
# Direct/development API: JSON list of immediate trusted proxies; empty means peer only.
# Production Compose overrides this with the web container's fixed internal address.
# Uvicorn must retain --no-proxy-headers; nginx overwrites X-Forwarded-For.
TRUSTED_PROXY_CIDRS=[]
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CAPACITY=16384
RATE_LIMIT_AUTH=30
RATE_LIMIT_ANONYMOUS=60
RATE_LIMIT_USER=600
RATE_LIMIT_EXPENSIVE=120
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=30
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

DEEPSEEK_API_KEY=replace-with-your-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Attempts per user per UTC day, including retries and failed dispatched calls. 0 disables calls.
LLM_DAILY_BUDGET=20
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=1

SRS_RECOGNITION_FAST_MS=3000
SRS_RECOGNITION_SLOW_MS=12000
SRS_RECALL_FAST_MS=5000
SRS_RECALL_SLOW_MS=20000

TARGET_LANGUAGE=en
SOURCE_LANGUAGE=zh
MEDIA_DIR=data/media
LEXICON_DIR=data/lexicon
# Optional explicit SQLite artifact override (also used for offline fixture-backed tests).
# LEXICON_PATH=backend/tests/fixtures/lexicon_small.sqlite
# Scratch directory for project/user bundle archives (default: system temp).
# BUNDLE_WORK_DIR=data/bundles
APP_DOMAIN=localhost
CADDY_NETWORK=pandawords
# Choose a non-overlapping subnet and reserve this address solely for the web proxy.
PANDAWORDS_INTERNAL_SUBNET=172.30.195.0/24
PANDAWORDS_WEB_INTERNAL_IP=172.30.195.2
PIXABAY_API_KEY=replace-with-your-api-key
AUDIO_PROVIDER_ORDER=wiktionary,edge-tts
# Disable external audio calls for offline/fixture runs; existing cached audio remains usable.
AUDIO_NETWORK_ENABLED=true
# Set a descriptive contact URL/email before fetching Wikimedia recordings.
WIKIMEDIA_USER_AGENT=PandaWords/0.1 (personal vocabulary app; contact: your-project-url)
WIKIMEDIA_REQUEST_INTERVAL_SECONDS=0.5
AUDIO_TIMEOUT_SECONDS=30
AUDIO_MAX_BYTES=10485760
EDGE_TTS_VOICE_US=en-US-AriaNeural
EDGE_TTS_VOICE_UK=en-GB-SoniaNeural

# Whole-site pandawords.site backups (admin API + Compose `backup` service). Keep the directory
# outside MEDIA_DIR/LEXICON_DIR; production uses the site-backups volume at /data/site-backups.
SITE_BACKUP_DIR=data/backups/site
# Number of most recent complete archives kept; failed runs never prune older backups.
SITE_BACKUP_RETAIN=7
# Daily run time, UTC (HH:MM).
SITE_BACKUP_TIME=03:30
SITE_BACKUP_TIMEOUT_SECONDS=900
# A lock older than this is treated as left behind by a crashed backup/restore.
SITE_BACKUP_LOCK_STALE_SECONDS=21600
# Restore/verification bounds for archive entries and total expanded bytes.
SITE_BACKUP_MAX_ENTRIES=500000
SITE_BACKUP_MAX_BYTES=107374182400

PIP_FALLBACK_INDEX_URL=
NPM_FALLBACK_REGISTRY=
DOCKER_REGISTRY_MIRROR=

# Production: copy this file to deploy/.env (or beside the released compose.yml).
# Override the development values above; do not retain the placeholder secrets.
# APP_ENV=production
# SURREAL_URL=ws://surrealdb:8000/rpc
# SURREAL_DATABASE=production
# SURREAL_USER=root
# SURREAL_PASS=<random-database-password>
# JWT_SECRET=<long-random-secret>
# ADMIN_PASSWORD=<random-admin-password>
# PUBLIC_BASE_URL=https://words.example.com
# APP_DOMAIN=words.example.com
# CADDY_NETWORK=caddy
# MEDIA_DIR=/data/media
# LEXICON_DIR=/data/lexicon
APP_VERSION=0.1.0
