SURREAL_URL=ws://127.0.0.1:8100/rpc
SURREAL_TEST_URL=ws://127.0.0.1:8101/rpc
SURREAL_NAMESPACE=pandawords
SURREAL_DATABASE=dev
SURREAL_USER=root
SURREAL_PASS=change-me

API_PORT=8000
WEB_DEV_PORT=5173
PUBLIC_BASE_URL=http://localhost:5173
APP_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=30
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

DEEPSEEK_API_KEY=replace-with-your-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

SRS_RECOGNITION_FAST_MS=3000
SRS_RECOGNITION_SLOW_MS=12000
SRS_RECALL_FAST_MS=5000
SRS_RECALL_SLOW_MS=20000

TARGET_LANGUAGE=en
SOURCE_LANGUAGE=zh
MEDIA_DIR=data/media
LEXICON_DIR=data/lexicon
# Optional explicit SQLite artifact override (also used for offline fixture-backed tests).
# LEXICON_PATH=backend/tests/fixtures/lexicon_small.sqlite
APP_DOMAIN=localhost
CADDY_NETWORK=pandawords
PIXABAY_API_KEY=replace-with-your-api-key
AUDIO_PROVIDER_ORDER=wiktionary,edge-tts
# Disable external audio calls for offline/fixture runs; existing cached audio remains usable.
AUDIO_NETWORK_ENABLED=true
# Set a descriptive contact URL/email before fetching Wikimedia recordings.
WIKIMEDIA_USER_AGENT=PandaWords/0.1 (personal vocabulary app; contact: your-project-url)
WIKIMEDIA_REQUEST_INTERVAL_SECONDS=0.5
AUDIO_TIMEOUT_SECONDS=30
AUDIO_MAX_BYTES=10485760
EDGE_TTS_VOICE_US=en-US-AriaNeural
EDGE_TTS_VOICE_UK=en-GB-SoniaNeural

PIP_FALLBACK_INDEX_URL=
NPM_FALLBACK_REGISTRY=
DOCKER_REGISTRY_MIRROR=

# Production: copy this file to deploy/.env (or beside the released compose.yml).
# Override the development values above; do not retain the placeholder secrets.
# APP_ENV=production
# SURREAL_URL=ws://surrealdb:8000/rpc
# SURREAL_DATABASE=production
# SURREAL_USER=root
# SURREAL_PASS=<random-database-password>
# JWT_SECRET=<long-random-secret>
# ADMIN_PASSWORD=<random-admin-password>
# PUBLIC_BASE_URL=https://words.example.com
# APP_DOMAIN=words.example.com
# CADDY_NETWORK=caddy
# MEDIA_DIR=/data/media
# LEXICON_DIR=/data/lexicon
APP_VERSION=0.1.0
